{
  "buildCommand": "",
  "outputDirectory": "api/static",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://netcoop-ai-api.onrender.com/api/:path*" }
  ]
}
